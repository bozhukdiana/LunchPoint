rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isStudent() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isTeacher());
      allow list: if isAdmin() || isTeacher();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /classes/{classId} {
      allow read: if isAdmin() || isTeacher() || isStudent();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /schoolYears/{schoolYearId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isAdmin() || isTeacher() || isStudent();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /meals/{mealId} {
      allow read: if isAdmin() || isTeacher() ||
        (isStudent() && resource.data.studentId == request.auth.uid);
      allow list: if isAdmin() || isTeacher() || isStudent();
      allow create: if isAdmin() || isTeacher() ||
        (isStudent() && request.resource.data.studentId == request.auth.uid);
      allow update: if isAdmin() || isTeacher();
      allow delete: if false;
    }

    match /logs/{logId} {
      allow read, create: if isAdmin() || isTeacher();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
