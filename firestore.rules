rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Authentication requires only a user's own authorization profile to be readable.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /classes/{classId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /schoolYears/{schoolYearId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // All non-admin domain access remains closed until its role-based policy is implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
